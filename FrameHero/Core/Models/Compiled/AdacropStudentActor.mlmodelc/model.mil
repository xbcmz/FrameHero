            tensor<fp16, [1, 256]> linear_1_cast_fp16 = linear(bias = student_actor_3_bias_to_fp16, weight = student_actor_3_weight_to_fp16, x = input_277_cast_fp16)[name = tensor<string, []>("linear_1_cast_fp16")];
            tensor<fp16, [1, 256]> input_283_cast_fp16 = relu(x = linear_1_cast_fp16)[name = tensor<string, []>("input_283_cast_fp16")];
            tensor<fp16, [7, 256]> student_actor_6_weight_to_fp16 = const()[name = tensor<string, []>("student_actor_6_weight_to_fp16"), val = tensor<fp16, [7, 256]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(2707648)))];
            tensor<fp16, [7]> student_actor_6_bias_to_fp16 = const()[name = tensor<string, []>("student_actor_6_bias_to_fp16"), val = tensor<fp16, [7]>([-0x1.d9p-4, 0x1.c48p-6, -0x1.474p-5, 0x1.6a4p-8, 0x1.0bcp-5, 0x1.2a8p-6, -0x1.0dp-5])];
            tensor<fp16, [1, 7]> linear_2_cast_fp16 = linear(bias = student_actor_6_bias_to_fp16, weight = student_actor_6_weight_to_fp16, x = input_283_cast_fp16)[name = tensor<string, []>("linear_2_cast_fp16")];
            tensor<fp16, [1, 7]> action_probs = softmax(axis = var_11, x = linear_2_cast_fp16)[name = tensor<string, []>("op_772_cast_fp16")];
        } -> (action_probs);
}